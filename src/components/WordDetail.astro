---
import type { WordItem } from '../utils/text';
import { formatSentenceHtml, extractTwitchClipSlug } from '../utils/text';

interface Props {
  word: WordItem;
  isModal?: boolean;
}

const { word, isModal = false } = Astro.props;
const highlightedSentence = formatSentenceHtml(word.sentence, word.term, word.wordRange);
const hasClip = Boolean(word.twitchClipUrl);
const clipSlug = extractTwitchClipSlug(word.twitchClipUrl);
---

<div class="word-detail-container flex flex-col gap-5" data-word-id={word.id}>
  <!-- Word Header -->
  <div class="border-b border-border-default pb-3 flex flex-wrap items-baseline justify-between gap-3">
    <div class="flex items-baseline gap-3 flex-wrap">
      <h1 class="text-3xl sm:text-4xl font-bold font-jp text-text-bright">
        {word.term}
      </h1>
      <span class="text-lg sm:text-xl text-text-muted font-mono">
        {word.reading}
      </span>
      {word.pitchAccent && (
        <span class="text-xs font-mono text-accent-amber">
          [{word.pitchAccent.pattern || word.pitchAccent.downstep}]
        </span>
      )}
    </div>

    <div class="flex items-center gap-2 font-mono text-xs">
      <a href={`/works/${word.workSlug}`} class="text-accent-amber hover:underline">
        [ {word.tag} ]
      </a>
      {hasClip && (
        <span class="border border-accent-rust text-accent-rust px-1.5 py-0.5">
          [ CLIP ]
        </span>
      )}
      {word.frequencyRank && (
        <span class="text-text-dim">
          #{word.frequencyRank}
        </span>
      )}
    </div>
  </div>

  <!-- Media Display -->
  {hasClip ? (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="aspect-video bg-black border border-border-default flex items-center justify-center overflow-hidden">
        {word.screenshotUrl ? (
          <img
            src={word.screenshotUrl}
            alt={word.term}
            class="w-full h-full object-contain"
          />
        ) : (
          <span class="text-text-dim font-mono text-xs">[ No Image ]</span>
        )}
      </div>

      <div 
        class="aspect-video bg-black border border-border-default flex items-center justify-center twitch-embed-container"
        data-clip-slug={clipSlug}
        data-clip-url={word.twitchClipUrl}
      >
        <div class="twitch-fallback text-center p-4">
          <a
            href={word.twitchClipUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 border border-accent-rust text-accent-rust font-mono text-xs hover:bg-accent-rust hover:text-canvas transition-colors"
          >
            [ Watch Clip &nearr; ]
          </a>
        </div>
      </div>
    </div>
  ) : (
    <div class="w-full aspect-video max-h-[480px] bg-black border border-border-default flex items-center justify-center overflow-hidden">
      {word.screenshotUrl ? (
        <img
          src={word.screenshotUrl}
          alt={word.term}
          class="w-full h-full object-contain"
        />
      ) : (
        <span class="text-text-dim font-mono text-xs">[ No Image ]</span>
      )}
    </div>
  )}

  <!-- Context Sentence -->
  <div class="border border-border-default bg-surface-alt p-4">
    <p 
      class="text-base sm:text-lg font-jp text-text-bright leading-relaxed"
      set:html={highlightedSentence}
    />
  </div>

  <!-- Definitions -->
  <div class="border border-border-default bg-surface-alt p-4">
    {word.definitions && word.definitions.length > 0 ? (
      <ul class="space-y-2 font-mono text-xs sm:text-sm text-text-main">
        {word.definitions.map((def, idx) => (
          <li class="flex items-start gap-2">
            <span class="text-text-dim shrink-0">[{idx + 1}]</span>
            <span>{def}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="font-mono text-xs text-text-muted">
        {word.definitionText || 'No definition available.'}
      </p>
    )}
  </div>

  <!-- Actions -->
  <div class="pt-2 flex items-center justify-between font-mono text-xs">
    <button 
      type="button" 
      class="copy-link-btn px-2.5 py-1 border border-border-default hover:border-accent-amber bg-surface hover:bg-surface-alt text-text-muted hover:text-text-bright transition-colors"
      data-copy-url={`/words/${word.id}`}
    >
      [ Copy Link ]
    </button>
    {isModal && (
      <a 
        href={`/words/${word.id}`}
        class="text-text-muted hover:text-accent-amber hover:underline"
      >
        [ Permapage &rarr; ]
      </a>
    )}
  </div>
</div>

<script>
  function setupTwitchEmbeds() {
    const containers = document.querySelectorAll<HTMLElement>('.twitch-embed-container');
    const hostname = window.location.hostname || 'localhost';

    containers.forEach((container) => {
      const clipSlug = container.getAttribute('data-clip-slug');
      if (!clipSlug) return;
      if (container.querySelector('iframe')) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://clips.twitch.tv/embed?clip=${clipSlug}&parent=${hostname}&autoplay=false`;
      iframe.className = 'w-full h-full border-0';
      iframe.allowFullscreen = true;

      container.innerHTML = '';
      container.appendChild(iframe);
    });
  }

  function setupCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-link-btn').forEach((btn) => {
      btn.onclick = async () => {
        const path = btn.getAttribute('data-copy-url');
        const url = `${window.location.origin}${path}`;
        try {
          await navigator.clipboard.writeText(url);
          const orig = btn.textContent;
          btn.textContent = '[ Copied ]';
          setTimeout(() => { btn.textContent = orig; }, 1500);
        } catch {
          prompt('Copy link:', url);
        }
      };
    });
  }

  setupTwitchEmbeds();
  setupCopyButtons();
</script>
