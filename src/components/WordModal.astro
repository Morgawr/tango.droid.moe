---
---

<div
  id="word-modal"
  class="fixed inset-0 z-50 hidden bg-black/80 p-2 sm:p-4 flex items-center justify-center select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Word Detail"
>
  <div 
    class="relative w-full max-w-3xl max-h-[90vh] flex flex-col bg-surface border border-border-default shadow-2xl select-text"
    id="word-modal-dialog"
  >
    <!-- Modal Titlebar -->
    <div class="px-4 py-2 bg-surface-alt border-b border-border-default flex items-center justify-between font-mono text-xs select-none">
      <div class="flex items-center gap-2">
        <span id="modal-titlebar-entry" class="text-text-bright font-semibold"></span>
        <span class="text-border-default">|</span>
        <span id="modal-titlebar-work" class="text-text-muted"></span>
      </div>

      <button
        type="button"
        id="modal-close-btn"
        class="px-2 py-0.5 border border-border-default hover:border-accent-amber hover:text-accent-amber bg-surface text-text-bright font-mono transition-colors"
        aria-label="Close"
      >
        [ Close &times; ]
      </button>
    </div>

    <!-- Modal Body -->
    <div id="modal-content" class="overflow-y-auto p-4 sm:p-5">
      <!-- Injected dynamically -->
    </div>

    <!-- Navigation Footer -->
    <div class="px-4 py-2 bg-surface-alt border-t border-border-default flex items-center justify-between font-mono text-xs select-none">
      <button
        type="button"
        id="modal-prev-btn"
        class="px-2.5 py-1 border border-border-default hover:border-accent-amber bg-surface text-text-muted hover:text-text-bright transition-colors"
      >
        [ &larr; Prev ]
      </button>

      <span id="modal-nav-counter" class="text-text-dim">
        0 / 0
      </span>

      <button
        type="button"
        id="modal-next-btn"
        class="px-2.5 py-1 border border-border-default hover:border-accent-amber bg-surface text-text-muted hover:text-text-bright transition-colors"
      >
        [ Next &rarr; ]
      </button>
    </div>
  </div>
</div>
