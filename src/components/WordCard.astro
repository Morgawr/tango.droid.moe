---
import type { WordItem } from '../utils/text';
import { formatSentenceHtml } from '../utils/text';

interface Props {
  word: WordItem;
}

const { word } = Astro.props;
const highlightedSentence = formatSentenceHtml(word.sentence, word.term, word.wordRange);
const hasClip = Boolean(word.twitchClipUrl);
---

<article
  class="word-card group border border-border-default hover:border-border-green-bright bg-surface hover:bg-surface-alt transition-colors duration-150 flex flex-col cursor-pointer"
  data-id={word.id}
  data-term={word.term}
  data-reading={word.reading}
  data-work-slug={word.workSlug}
  data-work-tag={word.tag}
  data-has-clip={hasClip ? 'true' : 'false'}
  data-frequency={word.frequencyRank || 999999}
  data-created={word.createdAt}
>
  <a href={`/words/${word.id}`} class="block flex-1 flex flex-col p-4 focus:outline-none focus:ring-1 focus:ring-accent-green" data-card-link>
    <!-- Card Top Header: Consistent vertical height across cards -->
    <div class="flex items-start justify-between gap-2 mb-3 min-h-[3.25rem]">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold font-jp text-text-bright tracking-tight group-hover:text-accent-green-bright transition-colors leading-tight">
          {word.term}
        </h3>
        <span class="text-xs sm:text-sm text-text-muted font-mono tracking-wide block">
          {word.reading}
        </span>
      </div>

      {hasClip && (
        <span class="border border-accent-rust text-accent-rust px-1.5 py-0.5 font-mono text-xs font-bold tracking-wider shrink-0">
          [ CLIP ]
        </span>
      )}
    </div>

    <!-- Screenshot Thumbnail -->
    <div class="w-full aspect-video bg-black border border-border-dim overflow-hidden mb-3">
      {word.thumbnailUrl ? (
        <img
          src={word.thumbnailUrl}
          alt={`Screenshot for ${word.term}`}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-200"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-text-dim text-xs font-mono">
          [ No Image ]
        </div>
      )}
    </div>

    <!-- Dialogue Sentence -->
    <div class="mb-3 flex-1">
      <p 
        class="text-xs sm:text-sm text-text-main font-jp leading-relaxed line-clamp-2"
        set:html={highlightedSentence}
      />
    </div>

    <!-- English Definition -->
    <div class="mb-3 pt-2 border-t border-border-dim">
      <p class="text-xs text-text-muted font-mono line-clamp-2">
        {word.definitionText || (word.definitions && word.definitions[0]) || 'No definition available.'}
      </p>
    </div>

    <!-- Card Footer -->
    <div class="mt-auto pt-2 border-t border-border-dim flex items-center justify-between text-xs font-mono text-text-dim">
      <span class="border border-border-green bg-surface-green px-1.5 py-0.5 text-accent-green-bright truncate max-w-[170px]">
        [ {word.tag} ]
      </span>
      <span>{word.dateFormatted}</span>
    </div>
  </a>
</article>
