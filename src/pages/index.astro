---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordCard from '../components/WordCard.astro';
import WordModal from '../components/WordModal.astro';
import words from '../data/words.json';
import works from '../data/works.json';
import type { WordItem } from '../utils/text';

const totalWords = words.length;
const totalClips = (words as WordItem[]).filter((w) => Boolean(w.twitchClipUrl)).length;
---

<BaseLayout title="tango.droid.moe" currentNav="words">
  <div class="space-y-4">
    <!-- Search & Filter Controls -->
    <div class="border border-border-default bg-surface p-3 sm:p-4 space-y-3 font-mono text-xs">
      <!-- Search & Sort Row -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3">
        <div class="relative flex-1">
          <input
            type="text"
            id="search-input"
            placeholder="Search vocabulary, reading, sentence, or definition..."
            class="w-full px-3 py-1.5 bg-canvas border border-border-default focus:border-accent-amber focus:outline-none text-text-bright font-mono text-xs placeholder-text-dim"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            id="clear-search-btn"
            class="absolute inset-y-0 right-0 pr-3 flex items-center text-text-dim hover:text-text-bright hidden font-mono text-xs"
            aria-label="Clear search query"
          >
            [ &times; ]
          </button>
        </div>

        <div class="flex items-center gap-2 shrink-0 text-text-dim">
          <label for="sort-select" class="shrink-0">[ Sort: ]</label>
          <select
            id="sort-select"
            class="bg-canvas border border-border-default px-2 py-1.5 text-text-bright focus:border-accent-amber focus:outline-none font-mono text-xs cursor-pointer"
          >
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="freq-asc">Most Common</option>
            <option value="freq-desc">Rarest</option>
            <option value="term">Term</option>
          </select>
        </div>
      </div>

      <!-- Filters & Counter Row -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-border-dim">
        <div class="flex flex-wrap items-center gap-1.5">
          <button
            type="button"
            data-filter-work="all"
            class="px-2 py-1 border border-accent-amber bg-surface-alt text-accent-amber font-semibold transition-colors"
          >
            [ All ({totalWords}) ]
          </button>
          {works.map((entry) => (
            <button
              type="button"
              data-filter-work={entry.slug}
              class="px-2 py-1 border border-border-default bg-surface text-text-muted hover:border-border-focus hover:text-text-bright transition-colors"
            >
              [ {entry.tag} ({entry.wordCount}) ]
            </button>
          ))}
          <button
            type="button"
            id="filter-clip-btn"
            class="px-2 py-1 border border-border-default bg-surface text-text-muted hover:border-border-focus hover:text-text-bright transition-colors"
          >
            [ Clips Only ({totalClips}) ]
          </button>
        </div>

        <div class="flex items-center gap-3 text-text-dim">
          <span id="filter-counter">
            {totalWords} / {totalWords}
          </span>
          <button
            type="button"
            id="reset-filters-btn"
            class="hover:text-accent-amber transition-colors"
          >
            [ Reset ]
          </button>
        </div>
      </div>
    </div>

    <!-- Cards Grid -->
    <div
      id="words-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
    >
      {(words as WordItem[]).map((word) => (
        <WordCard word={word} />
      ))}
    </div>

    <!-- Empty Results -->
    <div
      id="empty-results-state"
      class="hidden border border-border-default bg-surface p-8 text-center space-y-3 font-mono text-xs"
    >
      <div class="text-text-muted">No matching vocabulary found.</div>
      <button
        type="button"
        onclick="document.getElementById('reset-filters-btn')?.click()"
        class="px-3 py-1.5 border border-accent-amber text-accent-amber hover:bg-accent-amber hover:text-canvas transition-colors"
      >
        [ Clear Filters ]
      </button>
    </div>
  </div>

  <WordModal />

  <script id="all-words-data" type="application/json" set:html={JSON.stringify(words)} />
  <script src="../scripts/explorer.js"></script>
  <script src="../scripts/modal.js"></script>
</BaseLayout>
