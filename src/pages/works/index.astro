---
import BaseLayout from '../../layouts/BaseLayout.astro';
import works from '../../data/works.json';
---

<BaseLayout title="Works — tango.droid.moe" currentNav="works">
  <div class="space-y-4">
    <div class="border-b border-border-default pb-3">
      <h1 class="text-xl font-bold font-mono text-text-bright">
        Works
      </h1>
    </div>

    <div class="border border-border-default bg-surface divide-y divide-border-dim font-mono text-xs">
      {works.map((entry) => (
        <div class="p-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="text-base font-bold font-jp text-text-bright">
              {entry.tag}
            </span>
            {entry.vndbId && (
              <a
                href={`https://vndb.org/${entry.vndbId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent-amber hover:underline"
              >
                [ VNDB &nearr; ]
              </a>
            )}
          </div>

          <div class="flex items-center gap-4 text-text-muted">
            <span>{entry.wordCount} words</span>
            {entry.clipCount > 0 && (
              <span class="text-accent-rust">{entry.clipCount} clips</span>
            )}
            <a
              href={`/works/${entry.slug}`}
              class="px-2.5 py-1 border border-border-default hover:border-accent-amber bg-surface hover:bg-surface-alt text-text-bright transition-colors"
            >
              [ View &rarr; ]
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
