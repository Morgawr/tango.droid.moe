---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WordCard from '../../components/WordCard.astro';
import WordModal from '../../components/WordModal.astro';
import words from '../../data/words.json';
import works from '../../data/works.json';
import type { WordItem } from '../../utils/text';

export async function getStaticPaths() {
  return works.map((entry) => ({
    params: { slug: entry.work.slug },
    props: { entry },
  }));
}

interface Props {
  entry: (typeof works)[number];
}

const { entry } = Astro.props;
const workWords = (words as WordItem[]).filter(
  (w) => w.workSlug === entry.work.slug || w.tag === entry.tag
);
---

<BaseLayout
  title={`${entry.work.title} Vocabulary — tango.droid.moe`}
  description={`All ${workWords.length} vocabulary words mined from ${entry.work.title}.`}
  currentNav="works"
>
  <div class="space-y-6">
    <!-- Breadcrumb -->
    <div class="font-mono text-xs">
      <a href="/works" class="text-text-muted hover:text-accent-amber transition-colors">
        [ &larr; Return to Works Catalog ]
      </a>
    </div>

    <!-- Work Header Panel -->
    <div class="border border-border-default bg-surface p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-border-default pb-4 mb-4">
        <div>
          <span class="text-xs font-mono text-accent-amber">[ SOURCE ARCHIVE // {entry.work.slug.toUpperCase()} ]</span>
          <h1 class="text-2xl sm:text-4xl font-bold font-jp text-text-bright mt-1">
            {entry.work.title}
          </h1>
        </div>

        <div class="flex flex-col items-start sm:items-end gap-2 font-mono text-xs">
          {entry.work.vndbId && (
            <a
              href={`https://vndb.org/${entry.work.vndbId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-border-default hover:border-accent-amber px-2.5 py-1 text-accent-amber bg-surface-alt transition-colors"
            >
              [ VNDB: {entry.work.vndbId} ★ {entry.work.vndbRating} &nearr; ]
            </a>
          )}
          <span class="text-text-dim">DEVELOPER: <strong class="text-text-main">{entry.work.developer || 'Unknown'}</strong></span>
          <span class="text-text-dim">RELEASE: <strong class="text-text-main">{entry.work.releaseYear || 'Unknown'}</strong></span>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-text-muted font-mono leading-relaxed mb-4">
        {entry.work.description}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-text-dim pt-3 border-t border-border-dim">
        <span>WORDS: <strong class="text-accent-amber">{workWords.length}</strong></span>
        <span>TWITCH CLIPS: <strong class="text-accent-rust">{entry.clipCount}</strong></span>
        <span>LAST MINED: <strong class="text-text-main">{entry.lastMined}</strong></span>
      </div>
    </div>

    <!-- Mined Words Grid -->
    <div>
      <div class="flex items-center justify-between mb-4 font-mono text-xs text-text-dim">
        <span>// VOCABULARY MINED FROM THIS WORK ({workWords.length} ITEMS)</span>
        <a href={`/?work=${entry.work.slug}`} class="text-accent-amber hover:underline">
          [ Open in Main Explorer &rarr; ]
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="words-grid">
        {workWords.map((word) => (
          <WordCard word={word} />
        ))}
      </div>
    </div>
  </div>

  <WordModal />

  <!-- Words JSON for client-side modal scripts -->
  <script id="all-words-data" type="application/json" set:html={JSON.stringify(workWords)} />
  <script src="../../scripts/modal.js"></script>
</BaseLayout>
