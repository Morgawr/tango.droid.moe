---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WordCard from '../../components/WordCard.astro';
import WordModal from '../../components/WordModal.astro';
import words from '../../data/words.json';
import works from '../../data/works.json';
import type { WordItem } from '../../utils/text';

export async function getStaticPaths() {
  return works.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: (typeof works)[number];
}

const { entry } = Astro.props;
const workWords = (words as WordItem[]).filter(
  (w) => w.workSlug === entry.slug || w.tag === entry.tag
);
---

<BaseLayout title={`${entry.tag} — tango.droid.moe`} currentNav="works">
  <div class="space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4 font-mono text-xs">
      <a href="/works" class="px-2.5 py-1 border border-border-default hover:border-accent-green bg-surface hover:bg-surface-alt text-text-muted hover:text-accent-green-bright transition-colors">
        [ &larr; Works ]
      </a>

      {entry.vndbId && (
        <a
          href={`https://vndb.org/${entry.vndbId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-accent-green-bright hover:underline"
        >
          [ VNDB &nearr; ]
        </a>
      )}
    </div>

    <div class="border-b border-border-default pb-3 flex items-baseline justify-between gap-4">
      <h1 class="text-2xl sm:text-3xl font-bold font-jp text-accent-green-bright">
        {entry.tag}
      </h1>
      <span class="font-mono text-xs border border-border-green bg-surface-green px-1.5 py-0.5 text-accent-green-bright">
        {workWords.length} words
      </span>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="words-grid">
      {workWords.map((word) => (
        <WordCard word={word} />
      ))}
    </div>
  </div>

  <WordModal />

  <script id="all-words-data" type="application/json" set:html={JSON.stringify(workWords)} />
  <script src="../../scripts/modal.js"></script>
</BaseLayout>
